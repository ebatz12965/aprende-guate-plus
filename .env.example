APP_NAME="Aprende Guate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=http://localhost
APP_TIMEZONE=America/Guatemala
# Verificación en dos pasos obligatoria para quien tenga permisos de administración (por defecto: solo en producción).
# ADMIN_REQUIRE_TWO_FACTOR=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Local con Laragon: DB_CONNECTION=mysql y descomenta las líneas siguientes.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=aprende_guate_plus
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cierre por inactividad real (las consultas automáticas no cuentan). Cuentas con administración: límite más corto.
SESSION_IDLE_MINUTES=30
SESSION_IDLE_ADMIN_MINUTES=15
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Debe ser mayor que el timeout de los jobs de IA: 2 × (AI_CONNECT_TIMEOUT + AI_GENERATION_TIMEOUT) × AI_RETRY_TIMES + 22.
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=usuario_smtp
MAIL_PASSWORD=contraseña_o_api_key_smtp
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inicio de sesión con Google (Socialite). Opcional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# IA: proveedor OpenAI. La clave real debe vivir únicamente en .env y nunca en la base de datos.
AI_PROVIDER=openai
# Proveedores adicionales: cada uno se activa en el orquestador al tener su clave.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_CONNECT_TIMEOUT=5
AI_GENERATION_TIMEOUT=30
AI_TUTOR_TIMEOUT=20
AI_RETRY_TIMES=1
AI_ARCHITECTURE_MAX_TOKENS=5000
AI_ANALYSIS_MAX_TOKENS=2500
AI_DIAGNOSTIC_MAX_TOKENS=5000
AI_LESSON_MAX_TOKENS=3200
AI_PRACTICE_MAX_TOKENS=2400
AI_EVALUATION_MAX_TOKENS=900
AI_CONTENT_TIMEOUT=75
AI_CONTENT_REVIEW=true

# Deshabilitar en producción; activar únicamente durante diagnósticos locales controlados.
TELESCOPE_ENABLED=false

# Entrevista de RR. HH. por voz (OpenAI Realtime). Llamada corta para cuidar el consumo de audio.
AI_VOICE_MODEL=gpt-realtime-2.1-mini
AI_VOICE_MAX_SECONDS=300
AI_VOICE_DAILY_LIMIT=2
AI_VOICE_NAME=marin

# Narración de la biblioteca de Office con ElevenLabs (opcional). Elige una voz en español en tu cuenta y copia su ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Entrevista por voz: cada ruta completada da una. Cuentas de prueba con la voz siempre habilitada (separadas por coma).
AI_VOICE_UNRESTRICTED_EMAILS=

# Firma de los certificados de rutas completadas.
CERTIFICATE_SIGNER_NAME="Edwing Batz"
CERTIFICATE_SIGNER_TITLE="CEO de Aprende Guate"
